# Use a production PostgreSQL URL on the VPS. SQLite is suitable only for local development.
DATABASE_URL=sqlite:///./veritas.db
APP_ENV=development
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
PUBLIC_APP_URL=http://localhost:8000

# Required before first production startup. The process refuses to initialize an empty
# database without these values when APP_ENV=production.
VERITAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VERITAS_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-deploying
VERITAS_BOOTSTRAP_ADMIN_NAME=VERITAS Administrator

# Optional. When absent, email deliveries are persisted as queued for local development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VERITAS <onboarding@resend.dev>

# Phase 2 — GitHub OAuth (leave empty to disable Connect GitHub locally).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/workspace/github/callback
# Optional dedicated secret for encrypting GitHub tokens; falls back to bootstrap password in dev.
TOKEN_ENCRYPTION_SECRET=

# Phase 3/4 — optional AI (never commit real keys). Scans fail-open when unset.
# OpenRouter: Jev-style structured code review (Rules + AI).
OPENROUTER_API_KEY=
OPENROUTER_REVIEW_MODEL=openai/gpt-4o-mini
# Groq: final markdown report + remediations (Rules + AI).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REPORT_MODEL=

# Scan quotas (create endpoint).
SCAN_RATE_LIMIT=10
SCAN_CONCURRENT_LIMIT=2
